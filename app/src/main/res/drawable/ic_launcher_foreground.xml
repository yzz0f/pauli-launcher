<?xml version="1.0" encoding="utf-8"?>
<!--
  ferLauncher "open wheel": the upstream steering wheel recolored to the fork's Morado
  palette — a purple neon arc with a lighter head, the motion glow at night. Everything
  sits inside the 66 dp safe zone of the adaptive icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rim, open at the top -->
    <path
        android:pathData="M66,33.215 A24,24 0 1,1 42,33.215"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Neon arc: the motion glow travelling along the rim -->
    <path
        android:pathData="M66,33.215 A24,24 0 0,1 76.553,62.208"
        android:strokeColor="#A07CFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Glow head: the brightest point of the arc -->
    <path
        android:pathData="M66,33.215 A24,24 0 0,1 74.785,43.785"
        android:strokeColor="#E6DCFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Spokes -->
    <path
        android:pathData="M31,54 L47,54 M61,54 L77,54 M54,61 L54,77"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Hub -->
    <path
        android:fillColor="#A07CFF"
        android:pathData="M46,54 A8,8 0 1,0 62,54 A8,8 0 1,0 46,54 Z" />
</vector>
